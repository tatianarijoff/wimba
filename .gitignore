# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# WIMBA: artefacts generated by runs/tests (Z/W tables, figures).
# Uncomment the lines you need - keep control of what you commit.
# tests/**/output/
# *.dat
# *.png

# Generated example outputs (one folder per example)
examples/*_output/
**/*_output/

# more generated example artefacts
examples/**/output/
examples/resonator/*.dat
examples/resonator/*.png

# personal / generated
todo.md
*_assignments.csv

# large MAD-X twiss data (keep out of the repo)
examples/LHC/data/*.tfs
examples/CST_KickerFCC/

# generated by `wimba docs`
docs/html/

# Local settings: wimba.example.yaml is the tracked starter, wimba.yaml is
# yours. Machine-specific paths must not travel with the repository.
wimba.yaml

# Your own materials: custom_materials.example.yaml is the tracked starter,
# custom_materials.yaml is yours. Committing it would silently change other
# people's numbers on the next pull.
custom_materials.yaml
custom_materials.yml
wimba.yml

# Results computed inside an example project: reproducible from the configs,
# and large. The project.yaml and the configs are tracked, the output is not.
examples/*/*/output/
examples/*/*/img/

# Log directory when wimba.yaml sets logging.dir to a relative path
logs/
